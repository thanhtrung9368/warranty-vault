# WarrantyVault environment variables
# Copy to .env for local dev, set on Vercel dashboard for production.

# --- Database ---
# Local Postgres. Replace `<user>` with your OS user (default for Homebrew on
# macOS) or set explicit user/password. Create the DBs once:
#   createdb warranty_vault_dev
#   createdb warranty_vault_test     # only if you run the test scripts
DATABASE_URL="postgresql://<user>@localhost:5432/warranty_vault_dev"
# Production hosted Postgres (Neon, Supabase, Render, RDS, …):
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# Used by `node scripts/test-{backup-restore,cron-flow}.mjs`. Defaults to
# swapping the dev DB name for `warranty_vault_test`. Override only if you
# want to use a different test DB.
# TEST_DATABASE_URL="postgresql://<user>@localhost:5432/warranty_vault_test"

# Used by `docker compose up`. The compose file constructs DATABASE_URL
# from this and connects the app to the bundled postgres container.
# POSTGRES_PASSWORD="change-me"

# --- Session ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER reuse across environments. Changing = all users logged out.
SESSION_SECRET="change-me-must-be-at-least-32-chars-long"

# === Push notifications ===
# Web push (VAPID) — generate via: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the browser; the private key
# stays server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Apple Push Notification service (APNs) — for iOS native app.
# Get these from Apple Developer → Keys → "+ APNs Auth Key" (.p8 file).
# Paste the whole .p8 file contents (incl. BEGIN/END lines) into APNS_PRIVATE_KEY.
# Without these, the cron silently skips APNs subscriptions.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="com.warrantyvault.app"
APNS_PRIVATE_KEY=""
# "1" for production gateway, anything else => sandbox
# APNS_PRODUCTION="1"

# Firebase Cloud Messaging (FCM) — for Android native app.
# Generate Service Account JSON from Firebase Console → Project Settings → Service accounts.
# Paste the entire JSON content as a single line (escape newlines if needed).
FCM_SERVICE_ACCOUNT_JSON=""
# Optional override; defaults to project_id from the JSON above.
# FCM_PROJECT_ID=""

# --- Cron job protection ---
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>. Use a long random string.
CRON_SECRET="change-me-to-random-string"

# --- App URL (for password reset links) ---
APP_URL="http://localhost:3000"

# --- Email (Resend — optional, free 3K/month) ---
# Without these, password reset links print to server console (dev-friendly).
# RESEND_API_KEY="re_..."
# RESEND_FROM="WarrantyVault <noreply@yourdomain.com>"

# --- Encrypted attachments ---
# Master key wrapping per-file data keys (AES-256-GCM). Generate once:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating this requires re-wrapping every Attachment.wrappedKey in the DB.
FILE_MASTER_KEY=""

# Where encrypted attachments live on disk. Defaults to ./private-uploads.
# In Docker compose this is overridden to /data/private-uploads (volume).
# PRIVATE_UPLOAD_ROOT="./private-uploads"

# === Phase 3 / scaling ===
# Rate limiter backend. "memory" (default) is single-instance only — fine
# for local dev / single Vercel function. For multi-instance prod, set
# RATE_LIMITER=redis + Upstash REST creds (free tier works). Implementation
# in src/lib/rate-limit-upstash.ts (fail-open if Redis is down).
RATE_LIMITER=memory
# UPSTASH_REDIS_REST_URL="https://<region>-<name>-12345.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

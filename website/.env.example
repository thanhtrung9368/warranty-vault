# WarrantyVault — biến môi trường cho website/ (Next.js web UI)
# Sau Phase E, web là client của Go API. File này chỉ giữ env web thực sự cần.
# Copy sang `.env` cho dev local, hoặc set trên Vercel dashboard cho production.

# === Bắt buộc ===

# URL của Go backend (api/). Mọi server action proxy qua đây.
# Khi chạy `docker compose up`, compose tự set thành http://api:4000.
GO_API_URL="http://localhost:4000"

# Cookie iron-session cho web (`wv_session`).
# Phải >= 32 ký tự. Phải GIỐNG SESSION_SECRET ở Go (api/.env) để Go verify được cookie.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Đổi giá trị = log-out tất cả user web hiện tại.
SESSION_SECRET="change-me-must-be-at-least-32-chars-long"

# VAPID public key cho web push (client subscribe). Phải khớp với VAPID_PUBLIC_KEY ở Go.
# Tạo cặp khoá: npx web-push generate-vapid-keys
# Tiền tố NEXT_PUBLIC_ để Next.js expose ra browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# === Legacy — sẽ xoá sau Phase F (Block 2 trong NEXT.md) ===
# Mấy env dưới chỉ còn để legacy `website/src/app/api/v1/*` routes và RSC pages
# (stats, queries) hoạt động trong lúc đang migrate. Sau khi xoá Prisma khỏi
# website/, có thể remove hết phần này.

# Postgres dùng cho Prisma client còn sót trong website/.
# Production hosted (Neon, Supabase, Render, RDS, …):
# DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"
# TODO(Phase F): xoá sau khi decommission `/api/v1/*` và `prisma/`.
DATABASE_URL="postgresql://<user>@localhost:5432/warranty_vault_dev"

# Dùng bởi `node scripts/test-{backup-restore,cron-flow}.mjs`. Defaults sang
# `warranty_vault_test`. Mấy script này cũng sẽ bị xoá ở Phase F.
# TEST_DATABASE_URL="postgresql://<user>@localhost:5432/warranty_vault_test"

# Mật khẩu Postgres bundled trong `docker-compose.yml`. Compose tự build
# DATABASE_URL từ đây.
# POSTGRES_PASSWORD="change-me"

# Web-push fanout vẫn chạy từ Next.js cron `api/cron/warranty-check` cho đến
# khi Phase F xoá nó. Sau đó cron Go đảm nhiệm hết.
# TODO(Phase F): xoá VAPID_PRIVATE_KEY + VAPID_SUBJECT khỏi web — chỉ Go cần.
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# APNs / FCM cũng đang chạy từ Next.js cron. Sau Phase F: chỉ ở api/.
# TODO(Phase F): xoá toàn bộ block APNS_* và FCM_* khỏi web.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="com.warrantyvault.app"
APNS_PRIVATE_KEY=""
# "1" = production gateway, khác = sandbox.
# APNS_PRODUCTION="1"

FCM_SERVICE_ACCOUNT_JSON=""
# Mặc định lấy project_id từ JSON ở trên.
# FCM_PROJECT_ID=""

# Cron entrypoint Next.js (`/api/cron/warranty-check`). Vercel Cron gửi
# Authorization: Bearer <CRON_SECRET>. TODO(Phase F): xoá cùng route.
CRON_SECRET="change-me-to-random-string"

# Base URL cho link reset password trong email.
APP_URL="http://localhost:3000"

# Resend cho email reset password. Không set = link in ra console (dev).
# RESEND_API_KEY="re_..."
# RESEND_FROM="WarrantyVault <noreply@yourdomain.com>"

# Attachment encryption (legacy — Go cũng đọc cùng key). TODO(Phase F): xoá khỏi web.
# Tạo: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
FILE_MASTER_KEY=""
# PRIVATE_UPLOAD_ROOT="./private-uploads"

# Rate limiter: "memory" (single-instance) hoặc Upstash REST.
RATE_LIMITER=memory
# UPSTASH_REDIS_REST_URL="https://<region>-<name>-12345.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  devices        Device[]
  subscriptions  PushSubscription[]
  passwordResets PasswordReset[]
  wishlistItems  WishlistItem[]
  softwareSubs   Subscription[]
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Global catalogs (shared across users; admin edits via Prisma Studio).

model Category {
  code      String  @id // e.g. LAPTOP, PHONE, HEADPHONE
  name      String  // Vietnamese label
  sortOrder Int     @default(100)
  isActive  Boolean @default(true)

  brands BrandCategory[]
}

model Brand {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  categories BrandCategory[]
}

// Many-to-many: which brands are popular for which categories.
// A brand with no rows here is shown as "general" (always available).
model BrandCategory {
  brandId      String
  categoryCode String

  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryCode], references: [code], onDelete: Cascade)

  @@id([brandId, categoryCode])
  @@index([categoryCode])
}

model Store {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  type     String  @default("BOTH") // ONLINE | OFFLINE | BOTH
  isActive Boolean @default(true)
}

// Catalog of warranty providers. When a user picks one in the device form,
// the UI autofills phone/address/notes; the snapshot is stored on the
// Warranty row, so future provider edits don't retroactively change devices.
model WarrantyProvider {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  phone      String?
  address    String?
  websiteUrl String?
  notes      String?
  isActive   Boolean @default(true)
}

model Device {
  id            String   @id @default(cuid())
  userId        String
  name          String
  category      String   // FK-ish to Category.code (validated in app)
  brand         String?
  model         String?
  serialNumber  String?
  purchaseDate  DateTime
  purchasePrice Int      // VND, integer
  purchasePlace String?
  status        String   @default("ACTIVE") // ACTIVE | EXPIRED | SOLD | BROKEN | LOST
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  warranties  Warranty[]
  wishlistOrigin WishlistItem[] @relation("PurchasedFromWishlist")

  @@index([userId])
  @@index([purchaseDate])
  @@index([category])
  @@index([status])
}

// Warranty package per device. A device can have 0..N warranties:
// STANDARD (manufacturer), EXTENDED (e.g. AppleCare+, FPT extended),
// THIRD_PARTY (retailer, credit card, etc.). The device's effective
// warranty end is max(endDate) over its warranties.
model Warranty {
  id        String   @id @default(cuid())
  deviceId  String
  type      String   // STANDARD | EXTENDED | THIRD_PARTY
  provider  String?
  startDate DateTime
  endDate   DateTime
  months    Int
  cost      Int?     // VND, integer; price of the warranty package
  address   String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device    Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([deviceId])
  @@index([endDate])
  @@index([type])
}

model Attachment {
  id          String   @id @default(cuid())
  deviceId    String
  fileName    String   // user-provided original filename
  storagePath String   // relative to PRIVATE_UPLOAD_ROOT, e.g. "<deviceId>/<uuid>.enc"
  fileType    String   // plaintext MIME (image/jpeg, application/pdf, ...)
  fileSize    Int      // plaintext bytes (for quota + UI display)
  iv          Bytes    // 12 bytes (AES-GCM nonce for the file body)
  wrappedKey  Bytes    // wrapIv(12) || wrappedDataKey(48) — wrapped with FILE_MASTER_KEY
  description String?
  uploadedAt  DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

// Per-warranty "user dismissed alert" marker. When isDismissed=true the
// reminders page hides this warranty and the cron skips push for it.
model Reminder {
  id          String   @id @default(cuid())
  warrantyId  String
  isDismissed Boolean  @default(false)
  createdAt   DateTime @default(now())

  warranty Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  @@index([warrantyId])
  @@index([isDismissed])
}

// Recurring software/service subscriptions (Apple One, ChatGPT Plus, iCloud+).
// Distinct from Device: nothing physical, no warranty — but the same expiry +
// reminder lifecycle, so reuse the cron and notification infra.
model Subscription {
  id            String   @id @default(cuid())
  userId        String
  name          String   // "Apple One", "ChatGPT Plus"
  category      String?  // FK-ish to Category.code (validated in app)
  brand         String?  // "Apple", "OpenAI", "Google"
  plan          String?  // "Family", "Pro", "200GB", "Team-5"
  billingCycle  String   // MONTHLY | QUARTERLY | YEARLY | LIFETIME | CUSTOM
  intervalDays  Int?     // used when billingCycle=CUSTOM (e.g. 14, 90)
  price         Int      // VND / cycle
  currency      String   @default("VND")
  startedAt     DateTime
  renewalDate   DateTime // next charge (or "lifetime" sentinel)
  autoRenew     Boolean  @default(true)
  status        String   @default("ACTIVE") // ACTIVE | PAUSED | CANCELED | EXPIRED
  accountEmail  String?
  paymentMethod String?  // "Visa **4242", "Momo", "Apple ID"
  manageUrl     String?
  cancelUrl     String?
  notes         String?
  // De-dupe push notifications. Cron stamps this when warning + when auto-bill
  // happens, so we don't double-push for the same renewal.
  lastNotifiedRenewalAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@index([userId])
  @@index([renewalDate])
  @@index([status])
}

// Append-only per-cycle billing log. Each row = one charge. Cron auto-creates
// these when renewalDate passes for an ACTIVE + autoRenew sub.
model SubscriptionPayment {
  id             String   @id @default(cuid())
  subscriptionId String
  amount         Int      // VND
  paidAt         DateTime
  note           String?  // "tăng giá", "khuyến mãi", "auto-renew"
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([paidAt])
}

// Wishlist — products the user is "thèm" (eyeing). Distinct from Device:
// nothing has been purchased yet. Once status flips to PURCHASED a Device row
// is created and linked back via purchasedDeviceId.
model WishlistItem {
  id                   String    @id @default(cuid())
  userId               String
  name                 String
  category             String?   // FK-ish to Category.code (validated in app)
  brand                String?
  initialPrice         Int?      // VND when first noted
  currentPrice         Int?      // VND latest known
  buyUrl               String?
  imageUrl             String?
  targetDate           DateTime? // planned buy date (day-resolution)
  priority             String    @default("WANT")     // MUST | WANT | MAYBE
  status               String    @default("WATCHING") // WATCHING | DECIDED | SKIPPED | PURCHASED
  notes                String?
  reminderIntervalDays Int?      // null = no periodic ping; else cron pings every N days
  lastNotifiedAt       DateTime?
  purchasedDeviceId    String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  prices          WishlistPrice[]
  purchasedDevice Device?         @relation("PurchasedFromWishlist", fields: [purchasedDeviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([targetDate])
  @@index([purchasedDeviceId])
}

// Append-only price log for a wishlist item. Updating currentPrice writes a
// new row here so the detail page can render a sparkline.
model WishlistPrice {
  id         String   @id @default(cuid())
  itemId     String
  price      Int      // VND
  note       String?  // optional reason like "ưu đãi student"
  recordedAt DateTime @default(now())

  item WishlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([recordedAt])
}

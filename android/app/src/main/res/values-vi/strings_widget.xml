<?xml version="1.0" encoding="utf-8"?>
<!--
  TIẾNG VIỆT — bản gốc của widget + shortcut. Xem chú thích ở
  `values/strings_widget.xml` để biết hai luật (khoá trùng nhau, `%` trùng
  nhau) do `StringResourceParityTest` giữ.

  Widget hiển thị ngoài app nhưng KHÔNG theo ngôn ngữ của launcher: nó đọc
  `LanguageStore.current(context)` rồi tự wrap context, nên người dùng chọn
  tiếng Anh trong Cài đặt sẽ thấy widget tiếng Anh trên màn hình chính.
-->
<resources>

    <!-- ===== Widget màn hình chính ===== -->

    <string name="widget_name">Hạn bảo hành</string>
    <string name="widget_description">Hiển thị những ngày hết hạn bảo hành gần nhất bạn đã lưu trong Warrly.</string>
    <string name="widget_title">Hạn bảo hành</string>
    <string name="widget_open">Mở Warrly</string>

    <string name="widget_no_data_title">Chưa có dữ liệu hạn</string>

    <string name="shortcut_add_device_short">Thêm thiết bị</string>
    <string name="shortcut_add_device_long">Thêm thiết bị mới</string>
    <string name="shortcut_inbox_short">Hộp thư</string>
    <string name="shortcut_inbox_long">Mở hộp thư</string>


    <string name="widget_empty_title">Không có hạn nào trong 12 tháng tới</string>
    <string name="widget_empty_body">Mở Warrly để thêm thiết bị hoặc gói bảo hành.</string>

    <string name="widget_unnamed_device">Thiết bị chưa đặt tên</string>

    <!-- 0 và 1 có câu riêng; các số còn lại dùng plural (tiếng Việt chỉ có
         `other`, đúng như `StringResourceParityTest` yêu cầu). -->
    <string name="widget_expires_today">Hết hạn hôm nay</string>
    <string name="widget_expires_tomorrow">Hết hạn ngày mai</string>
    <plurals name="widget_days_left">
        <item quantity="other">Còn %1$d ngày</item>
    </plurals>

    <!-- Dòng "tính đến". Luôn hiện khi có snapshot; càng cũ chữ càng rõ. -->
    <string name="widget_as_of">tính đến %1$s</string>
    <string name="widget_stale_as_of">Dữ liệu cũ · tính đến %1$s</string>

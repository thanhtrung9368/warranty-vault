         which is the same screen on the other native client. ===== -->
    <string name="email_change_title">Change email</string>
    <string name="email_change_intro">Current sign-in email: %1$s. Once you confirm, every device is signed out and you have to sign in again with the new address.</string>
    <string name="email_change_intro_empty">—</string>
    <string name="email_change_step1_header">Step 1 — Send a code to the new address</string>
    <string name="email_change_new_email">New email address</string>
    <string name="email_change_current_password">Current password</string>
    <string name="email_change_requesting">Sending…</string>
    <string name="email_change_request">Send confirmation code</string>
    <string name="email_change_step2_header">Step 2 — Enter the confirmation code</string>
    <string name="email_change_token">Confirmation code from the email</string>
    <string name="email_change_confirming">Confirming…</string>
    <string name="email_change_confirm">Confirm email change</string>
    <string name="email_change_footer">The app cannot open the link in the email (it is a web page), so paste the code — or the whole link — into the box above. The code is single use and expires in %1$d minutes.</string>

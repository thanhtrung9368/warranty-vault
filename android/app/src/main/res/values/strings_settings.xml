<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings tab, profile sheet, email-change sheet, sessions, push devices and
  the change-password sheet.

  RESERVED PREFIXES — already defined and owned by the i18n scaffolding, do not
  re-add or rename:
    settings_lang_*     the language switcher row + sheet
    settings_email_*    the (now clickable) email row
    profile_*           ProfileEditSheet
    email_change_*      EmailChangeSheet
  Everything else in this file is fair game.
-->
<resources>

    <!-- ===== Language switcher (ui/screens/settings/LanguageSheet.kt). ===== -->
    <string name="settings_lang_row_title">Language</string>
    <string name="settings_lang_row_subtitle">The language of the app and of its notifications.</string>
    <string name="settings_lang_sheet_title">Choose a language</string>
    <string name="settings_lang_english">English</string>
    <string name="settings_lang_vietnamese">Vietnamese</string>
    <string name="settings_lang_footer">The choice is saved to your account so push notifications and emails arrive in the right language, not only the screens here.</string>
    <string name="settings_lang_saving">Saving…</string>

    <!-- ===== Profile row / email change entry point (SettingsScreen.kt). ===== -->
    <string name="settings_email_row_subtitle">%1$s · tap to change</string>

    <!-- ===== ProfileEditSheet.kt ===== -->
    <string name="profile_title">Edit profile</string>
    <string name="profile_display_name">Display name</string>
    <string name="profile_name_hint">Leave it empty to clear the name. At most 80 bytes (~26 Vietnamese characters).</string>
    <string name="profile_saved">Profile updated</string>

    <!-- ===== EmailChangeSheet.kt (POST /auth/change-email → /confirm-email-change).

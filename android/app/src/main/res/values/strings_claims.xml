<?xml version="1.0" encoding="utf-8"?>
<!--
  ENGLISH — the default catalog.

  Warranty claims (`ui/screens/devices/DeviceClaimsSection.kt` and
  `ClaimEditSheet.kt`, model in `network/Models.kt`). A claim is what happens
  after a device is marked BROKEN: the ticket, the shop, the diagnosis, what the
  warranty paid.

  Two rules this pair must satisfy are enforced by
  `StringResourceParityTest`: identical key sets, identical format verbs. The
  Vietnamese file is the original (`values-vi/`); this one is the translation.
-->
<resources>

    <!-- ===== The "Sửa chữa & bảo hành" section on the device detail. ===== -->
    <string name="claim_section_title">Repairs &amp; warranty</string>
    <string name="claim_add">Add ticket</string>
    <string name="claim_add_first">Add the first repair ticket</string>
    <string name="claim_empty_title">No repair ticket yet</string>
    <string name="claim_empty_body">Record the ticket number, the shop, the diagnosis and the cost, so the next visit has a paper trail.</string>

    <!-- The BROKEN dead end: a device marked broken with no live claim. -->
    <string name="claim_broken_nudge_title">This device is marked broken, but no repair is open</string>
    <string name="claim_broken_nudge_body">Open a repair ticket so the ticket number, the shop, the diagnosis and the cost stay with the device instead of in your head.</string>
    <string name="claim_broken_nudge_action">Open a repair ticket</string>


<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- App lock. Also contributed by the androidx.biometric manifest, but
         declared here so the permission the feature depends on is visible in
         this app's own manifest rather than only buried in a dependency. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Serial / IMEI scanning (AddDeviceSheet → SerialScannerDialog). Requested
         at runtime from the scan action, never at first launch: a user who never
         scans is never asked. Declaring it without the matching <uses-feature>
         below would make the app "require a camera" for Play filtering. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false": scanning is a convenience, not a requirement. Without
         this line the CAMERA permission alone implies android.hardware.camera
         and hides the app from camera-less devices (some tablets, TV boxes) —
         the serial field can always be typed into by hand. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Outgoing text shares (the handover certificate and the AI draft letter)
         query ACTION_SEND/text/plain so this app's own share target can be
         excluded from the chooser (see `ShareLinks.kt`). Android 11+ package
         visibility requires the intent to be declared here; without it the
         query can return a partial list and lint warns at the call site. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Warrly"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- launchMode="singleTop": a share delivered while the app is already
             running has to reach onNewIntent on the existing instance. With the
             default ("standard") Android would stack a SECOND MainActivity —
             two Compose shells, and Back would land on a stale copy of the app.
             It is also what the notification PendingIntent already assumes
             (it sets FLAG_ACTIVITY_SINGLE_TOP). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Warrly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share target (FEATURE_IDEAS #10): "Chia sẻ" on a product page
                 in Shopee / Lazada / Chrome → Warrly → the link lands in
                 the wishlist form prefilled.

                 It is also the OS-level entry point for receipts: an
                 `image/*` or `application/pdf` share (Gallery, Gmail, Files)
                 is copied while the intent is still live and lands on the
                 Inbox screen for confirmation. The MIME type is what routes
                 it — text/plain still goes to the wishlist exactly as before.

                 Data elements inside ONE filter mean "any of these types".
                 No ACTION_SEND_MULTIPLE on purpose: the code reads exactly one
                 stream (one SharedFile in memory, one confirmation card), and
                 advertising multi-select without that flow would show the app
                 in the chooser and then drop all but one file.

                 No ACTION_VIEW http/https filter on purpose — that would offer
                 this app as a *browser* for every link on the phone.

                 ⚠️ This is the mirror of the OUTGOING share added with the
                 handover certificate (#2): `ShareCertificatesSection` sends the
                 same ACTION_SEND + text/plain, so without care this app appears
                 in its own chooser and picking it re-enters the wishlist intake
                 with a certificate URL. That one component is excluded from that
                 chooser by package name — see `excludedShareTargets` in
                 `ui/screens/devices/ShareLinks.kt`, unit-tested. Nothing changes
                 here to keep both directions working: this filter is what the
                 *sending* user picked, and incoming shares behave exactly as
                 before. Both rely on `launchMode="singleTop"` above. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Launcher shortcuts (long-press the icon): "Add device" and
                 "Open the inbox". There was NO shortcuts resource before this
                 change; `res/xml/shortcuts.xml` is the first one. The intents
                 carry `com.warrly.extra.DESTINATION`, parked by MainActivity in
                 `NavigationIntake` and consumed by MainScreen — see
                 `AppDestination`. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Home-screen widget — the app's first AppWidgetProvider. Draws the
             next few warranty expiries from a locally cached snapshot; it never
             makes an authenticated call (see `DeadlineSnapshotUpdater`). The
             metadata (sizing, six-hour update period, preview) is
             `res/xml/deadline_widget_info.xml`.

             PRIVACY: a home-screen widget is visible to anyone holding the
             phone. We DO show the device name — a deadline with no device is not
             actionable, and the name is already the most prominent field in a
             lock-screen push notification — but the exposure is bounded:
               * `widgetCategory="home_screen"` (never `keyguard`) in that
                  metadata, so the card is not offered to lock-screen/widget
                  hosts;
               * at most four rows, ellipsized, plus a capture time and a
                  "no other deadlines" line;
               * the snapshot contains no price, serial, email, attachment or
                  provider data — only device id/name and the warranty end date;
               * `DeadlineSnapshotUpdater.clear()` wipes it on sign-out, so the
                  previous account's names cannot survive a logout.

             `exported="false"`: the system may deliver the explicit
             APPWIDGET_UPDATE broadcast, but no other app may invoke this
             receiver. -->
        <receiver
            android:name=".widget.WarrlyDeadlineWidgetProvider"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/deadline_widget_info" />
        </receiver>

        <!-- FCM token + inbound notification handler. Inert until a real
             google-services.json + Firebase project are configured. -->
        <service
            android:name=".core.push.WVMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FileProvider for sharing decrypted attachments with viewer apps.
             Authority must match AttachmentsSection.openAttachment(). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

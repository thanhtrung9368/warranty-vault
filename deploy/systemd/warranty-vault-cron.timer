# ─────────────────────────────────────────────────────────────────────────────
# WarrantyVault — daily cron timer (template)
#
# Trigger `warranty-vault-cron.service` mỗi ngày lúc 09:00 giờ Hà Nội.
# Asia/Ho_Chi_Minh = UTC+7 (không có DST) → 09:00 Hanoi = 02:00 UTC.
#
# Nếu VPS đặt timezone là Asia/Ho_Chi_Minh (`timedatectl set-timezone
# Asia/Ho_Chi_Minh`), có thể đổi `OnCalendar` thành `*-*-* 09:00:00` cho dễ
# đọc — systemd diễn giải theo timezone của host. Mặc định template dùng UTC
# để khỏi phụ thuộc cấu hình host.
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=Run WarrantyVault cron daily at 09:00 Asia/Ho_Chi_Minh (02:00 UTC)
Requires=warranty-vault-cron.service

[Timer]
# 02:00 UTC = 09:00 Hanoi (UTC+7).
OnCalendar=*-*-* 02:00:00

# Nếu VPS bị down lúc 02:00 UTC, chạy bù ngay khi up trở lại.
Persistent=true

# Tránh dồn cục lúc lẻ phút — randomize trong 60s.
RandomizedDelaySec=60

# Bám theo service name cùng prefix.
Unit=warranty-vault-cron.service

[Install]
WantedBy=timers.target

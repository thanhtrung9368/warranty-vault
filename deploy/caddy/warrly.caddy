# Warrly trên máy chủ DÙNG CHUNG (Caddy một bản, mỗi project một tệp trong sites/).
# Chép thành /etc/caddy/sites/warrly.caddy rồi:
#
#   caddy adapt --config /etc/caddy/Caddyfile >/dev/null && systemctl reload caddy
#
# Cloudflare đứng trước ở chế độ SSL **Full (strict)**: nó gọi vào cổng 443 và kiểm
# cert. Cert là Cloudflare Origin Certificate (warrly.com + *.warrly.com, 15 năm),
# chỉ Cloudflare tin — trình duyệt gọi thẳng vào IP sẽ báo cert lạ, đúng ý.
#   /etc/caddy/certs/warrly.pem  chứng chỉ (công khai)
#   /etc/caddy/certs/warrly.key  private key, sinh trên máy chủ, KHÔNG nằm trong repo
# Đổi sang Flexible thì phải quay về khối `http://` (như ttgo.caddy), nếu không
# Caddy redirect http→https và Cloudflare lặp vô tận.
#
# Để chặn gọi thẳng vào IP gốc (vòng qua Cloudflare/DDoS), cổng 80/443 chỉ nên
# cho dải IP Cloudflare — xem deploy/README.md. Ở đây chỉ tin CF-Connecting-IP
# khi nguồn thật sự là Cloudflare.

(warrly_proxy) {
	# Chỉ tin CF-Connecting-IP khi request thật sự đến từ Cloudflare; gọi thẳng vào
	# gốc kèm header giả thì dùng IP kết nối thật. Rate-limit của Go dựa vào
	# X-Forwarded-For, nên sai ở đây là cả thế giới chung một bucket.
	@tuCloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	reverse_proxy @tuCloudflare {args[0]} {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
	}
	reverse_proxy {args[0]}
}

# API (app iOS/Android gọi vào đây). Cron chỉ chạy nội bộ, không bao giờ qua proxy.
api.warrly.com {
	tls /etc/caddy/certs/warrly.pem /etc/caddy/certs/warrly.key
	import secure_headers
	@cron path /api/cron/* /api/v1/cron/*
	respond @cron "Not Found" 404
	request_body {
		max_size 10MB
	}
	import warrly_proxy 127.0.0.1:4000
}

# Web. www → apex 301 (apex là canonical: APP_URL và mọi metadataBase trỏ vào đó).
warrly.com, www.warrly.com {
	tls /etc/caddy/certs/warrly.pem /etc/caddy/certs/warrly.key
	import secure_headers
	@www host www.warrly.com
	redir @www https://warrly.com{uri} permanent
	@cron path /api/cron/*
	respond @cron "Not Found" 404
	request_body {
		max_size 10MB
	}
	encode zstd gzip
	import warrly_proxy 127.0.0.1:3000
}

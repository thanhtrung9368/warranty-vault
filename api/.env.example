# WarrantyVault Go API — environment variables
# Copy to .env for local dev. Production: set via systemd unit / docker secret.

# --- Server ---
PORT=4000
# CORS allowlist (browser → API). Comma-separated.
WEB_URL="http://localhost:3000"

# --- Database (shared with website/ during migration; same DATABASE_URL) ---
DATABASE_URL="postgresql://<user>@localhost:5432/warranty_vault_dev"

# --- Auth / sessions ---
# Session token TTL in days (default 30).
SESSION_TTL_DAYS=30

# --- Push notifications ---
# Web push (VAPID). Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# APNs (iOS native). Same shape as website/.env.example.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="com.warrantyvault.app"
APNS_PRIVATE_KEY=""
# APNS_PRODUCTION="1"

# FCM (Android native). Service account JSON, single-line.
FCM_SERVICE_ACCOUNT_JSON=""
# FCM_PROJECT_ID=""

# --- Cron ---
# Required Bearer for POST /api/v1/cron/warranty-check
CRON_SECRET="change-me-to-random-string"

# --- Email (Resend) ---
# RESEND_API_KEY="re_..."
# RESEND_FROM="WarrantyVault <noreply@yourdomain.com>"
APP_URL="http://localhost:3000"

# --- Encrypted attachments ---
# Same FILE_MASTER_KEY as website/. AES-256-GCM master key.
FILE_MASTER_KEY=""
PRIVATE_UPLOAD_ROOT="./private-uploads"

# --- Rate limit ---
# "memory" or "redis"
RATE_LIMITER=memory
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

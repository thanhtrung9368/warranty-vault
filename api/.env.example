# WarrantyVault Go API — biến môi trường cho api/
# Đây là backend chính (Phase E xong). Tất cả mutation và push fanout sẽ chạy ở đây sau Phase F.
# Copy sang `.env` cho dev local. Production: systemd unit / docker secret / dashboard.

# === Server ===

# Port HTTP server. Mặc định 4000.
PORT=4000

# CORS allowlist (browser → Go API). Comma-separated. Mobile dùng bearer
# nên không cần CORS, chỉ web mới cần khi gọi từ client component.
WEB_URL="http://localhost:3000"

# Base URL public của web (cho link reset password trong email,
# CORS allow list mở rộng nếu cần).
APP_URL="http://localhost:3000"

# === Database ===

# Postgres 17. Schema tạo bằng goose migration (`api/migrations/*.sql`),
# KHÔNG dùng Prisma từ Go side.
# Production hosted: postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL="postgresql://<user>@localhost:5432/warranty_vault_dev"

# === Auth / Session ===

# Cookie iron-session secret. Phải >= 32 ký tự. Phải GIỐNG SESSION_SECRET
# trong website/.env để Go đọc được cookie `wv_session` của web.
# Mobile dùng bearer token (table Session) — không phụ thuộc secret này.
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="change-me-must-be-at-least-32-chars-long"

# === Push notifications ===

# Web push (VAPID). Tạo cặp khoá: npx web-push generate-vapid-keys
# Public key phải khớp NEXT_PUBLIC_VAPID_PUBLIC_KEY ở website/.env.
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# APNs (iOS native). Lấy từ Apple Developer → Keys → "+ APNs Auth Key" (.p8).
# Paste nguyên nội dung file .p8 (kèm BEGIN/END) vào APNS_PRIVATE_KEY.
# Thiếu = cron silently skip APNs subscription.
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="com.warrantyvault.app"
APNS_PRIVATE_KEY=""
# "1" = production gateway, khác = sandbox.
# APNS_PRODUCTION="1"

# FCM (Android native). Service Account JSON 1 dòng (escape \n nếu cần).
# Tạo: Firebase Console → Project Settings → Service accounts → Generate new private key.
FCM_SERVICE_ACCOUNT_JSON=""
# Override project_id (mặc định lấy từ JSON ở trên).
# FCM_PROJECT_ID=""

# === Cron ===

# Bearer bắt buộc cho POST /api/v1/cron/warranty-check (cron Go).
# Đặt long random string. Trùng giá trị với CRON_SECRET web side trong giai đoạn migrate.
CRON_SECRET="change-me-to-random-string"

# === Email ===

# Resend (free 3K/tháng). Không set = reset link in ra log (dev-friendly).
# RESEND_API_KEY="re_..."
# RESEND_FROM="WarrantyVault <noreply@yourdomain.com>"

# === Encrypted attachments ===

# Master key wrap per-file data key (AES-256-GCM). 32 bytes base64 hoặc hex.
# Phải GIỐNG FILE_MASTER_KEY ở website/.env trong giai đoạn cùng đọc/ghi.
# Tạo: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotate = re-wrap mọi Attachment.wrappedKey (xem comment trong api/internal/files).
FILE_MASTER_KEY=""

# Thư mục lưu file encrypted trên đĩa. Docker compose override thành /data/uploads.
PRIVATE_UPLOAD_ROOT="./private-uploads"

# === Rate limit ===

# "memory" (default, single-instance) hoặc set 2 Upstash var bên dưới = redis.
RATE_LIMITER=memory
# UPSTASH_REDIS_REST_URL="https://<region>-<name>-12345.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

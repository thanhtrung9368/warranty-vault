<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The extension reads the language choice from App Group `UserDefaults`
	     (SharedInboxLanguage). WarrlyKit's own manifest covers the library
	     bundle; an app extension is a separate bundle, so it carries the same
	     required-reason declaration. 1C8F.1 is the App Group variant — CA92.1
	     would only cover defaults private to this bundle. The shared file
	     itself is only written to the App Group container, never uploaded from
	     here. -->
	<!-- Ads: this bundle does not import the Google Mobile Ads SDK and never
	     contacts an ad domain — it has no network client at all. The app-level
	     tracking declaration still appears here because App Store Connect
	     evaluates EVERY bundle in the archive, and the same flag must carry a
	     non-empty domain list wherever it is set (ITMS-91064: NSPrivacyTracking
	     true requires at least one NSPrivacyTrackingDomains entry). The collected
	     data types — IDFA, advertising data — are declared once, in
	     App/PrivacyInfo.xcprivacy, because only the app collects them. -->
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyTrackingDomains</key>
	<array>
		<string>googleadservices.com</string>
		<string>googleads.g.doubleclick.net</string>
		<string>doubleclick.net</string>
		<string>pagead2.googlesyndication.com</string>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>

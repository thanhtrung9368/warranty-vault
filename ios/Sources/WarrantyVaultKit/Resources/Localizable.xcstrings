    "IMEI đủ 15 chữ số nhưng sai số kiểm tra — có thể bạn gõ nhầm một chữ số.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The IMEI has 15 digits but fails its check digit — you may have mistyped one."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "IMEI đủ 15 chữ số nhưng sai số kiểm tra — có thể bạn gõ nhầm một chữ số."
          }
        }
      }
    },
    "Import từ file": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import from a file"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Import từ file"
          }
        }
      }
    },
    "Khi bật, ảnh hoá đơn sẽ được gửi (đã giải mã) tới dịch vụ AI bên thứ ba để tự điền thông tin. Bạn luôn kiểm tra lại trước khi lưu. Mặc định tắt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the receipt image is decrypted and sent to a third-party AI service to fill the form in for you. You always review it before saving. Off by default."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, ảnh hoá đơn sẽ được gửi (đã giải mã) tới dịch vụ AI bên thứ ba để tự điền thông tin. Bạn luôn kiểm tra lại trước khi lưu. Mặc định tắt."
          }
        }
      }
    },
    "Khi bật, ứng dụng sẽ yêu cầu Face ID/Touch ID — hoặc mã mở khoá của thiết bị — mỗi lần quay lại ứng dụng. Nếu thiết bị không còn mã mở khoá, khoá sẽ tự tắt để bạn không bị khoá cứng.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, the app asks for Face ID/Touch ID — or your device passcode — every time you come back to it. If the device no longer has a passcode the lock turns itself off, so you can never be locked out."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, ứng dụng sẽ yêu cầu Face ID/Touch ID — hoặc mã mở khoá của thiết bị — mỗi lần quay lại ứng dụng. Nếu thiết bị không còn mã mở khoá, khoá sẽ tự tắt để bạn không bị khoá cứng."
          }
        }
      }
    },
    "Khi gói bảo hành sắp hết, hệ thống đẩy thông báo tự động trước 7 ngày và 30 ngày. Mốc nhắc do máy chủ quy định — ứng dụng chưa hỗ trợ tuỳ chỉnh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a warranty is about to expire the server sends a push 7 days and 30 days ahead. The schedule is fixed server-side — the app cannot customise it."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi gói bảo hành sắp hết, hệ thống đẩy thông báo tự động trước 7 ngày và 30 ngày. Mốc nhắc do máy chủ quy định — ứng dụng chưa hỗ trợ tuỳ chỉnh."
          }
        }
      }
    },

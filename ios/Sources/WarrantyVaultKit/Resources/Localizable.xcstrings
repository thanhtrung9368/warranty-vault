  "sourceLanguage": "vi",
  "strings": {
    "\"%@\" sẽ bị xoá vĩnh viễn cùng toàn bộ gói bảo hành.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" will be deleted for good, along with every warranty on it."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" sẽ bị xoá vĩnh viễn cùng toàn bộ gói bảo hành."
          }
        }
      }
    },
    "\"%@\" và lịch sử giá sẽ bị xoá.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" and its price history will be deleted."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" và lịch sử giá sẽ bị xoá."
          }
        }

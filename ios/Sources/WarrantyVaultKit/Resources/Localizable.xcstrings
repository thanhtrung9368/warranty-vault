        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Link chỉ-đọc, có hạn, không cần đăng nhập. Mở để xem phần bảo hành còn lại."
          }
        }
      }
    },
    "Link dưới đây do chính hãng duy trì — app chỉ dẫn lại, không chép hotline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {

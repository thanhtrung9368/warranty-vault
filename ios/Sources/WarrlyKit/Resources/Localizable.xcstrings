          "stringUnit": {
            "state": "translated",
            "value": "Your account is at its device limit. Sell or delete an active device, then try again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản đã đạt giới hạn thiết bị. Bán hoặc xoá bớt một thiết bị đang dùng rồi thử lại."
          }

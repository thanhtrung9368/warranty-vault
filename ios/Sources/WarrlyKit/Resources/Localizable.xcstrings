          }
        }
      }
    },
    "Chưa lưu được văn bản OCR nên hoá đơn này chưa tìm thấy bằng từ khoá.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

    },
    "Bảng kê cho bảo hiểm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insurance property schedule"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảng kê cho bảo hiểm"
          }
        }
      }
    },
    "Tải một tệp PDF để gửi cho công ty bảo hiểm khi họ yêu cầu bảng kê tài sản: trang bìa, bảng kê giá trị và giá mua, từng thiết bị kèm điều khoản bảo hành và ảnh, cùng danh mục tệp đính kèm.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download a PDF to send to your insurer when they ask for a schedule of property: a cover page, a schedule of values and purchase prices, a page for each device with its warranty terms and photos, and a manifest of attachments."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải một tệp PDF để gửi cho công ty bảo hiểm khi họ yêu cầu bảng kê tài sản: trang bìa, bảng kê giá trị và giá mua, từng thiết bị kèm điều khoản bảo hành và ảnh, cùng danh mục tệp đính kèm."
          }
        }
      }
    },
    "Tệp PDF luôn ở tiếng Việt vì người đọc là công ty bảo hiểm hoặc giám định viên, không phải người dùng ứng dụng.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PDF is always in Vietnamese because it is read by the insurer or the adjuster, not by the app user."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp PDF luôn ở tiếng Việt vì người đọc là công ty bảo hiểm hoặc giám định viên, không phải người dùng ứng dụng."
          }
        }
      }
    },
    "Bao gồm cả thiết bị đã bán": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include sold devices"

      }
    },
    "Mặc định chỉ liệt kê thiết bị bạn đang sở hữu. Bật nếu hồ sơ bảo hiểm cần cả tài sản đã bán trong kỳ.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default only devices you still own are listed. Turn this on if the insurance file also needs items sold during the period."

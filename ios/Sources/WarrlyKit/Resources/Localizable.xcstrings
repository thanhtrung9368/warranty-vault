          }
        }
      }
    },
    "Đánh giá bảo hành dùng chung một lần bật AI với tính năng quét hoá đơn. Khi bật, thông tin lần sửa chữa (mô tả lỗi, chẩn đoán, chi phí) và điều khoản bảo hành sẽ được gửi tới dịch vụ AI bên thứ ba để phân tích." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warranty assessment uses the same AI opt-in as receipt scanning. When it is on, the repair details (problem description, diagnosis, cost) and warranty terms are sent to a third-party AI service for analysis."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh giá bảo hành dùng chung một lần bật AI với tính năng quét hoá đơn. Khi bật, thông tin lần sửa chữa (mô tả lỗi, chẩn đoán, chi phí) và điều khoản bảo hành sẽ được gửi tới dịch vụ AI bên thứ ba để phân tích."
          }
        }
      }
    },
    "Đánh giá này chỉ đọc dữ liệu và không sửa gì." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This assessment only reads your data and changes nothing."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh giá này chỉ đọc dữ liệu và không sửa gì."
          }
        }
      }
    },
    "Đây chính là thiết bị bạn đang cầm. Thu hồi xong bạn sẽ bị đăng xuất ngay và phải đăng nhập lại bằng email + mật khẩu." : {

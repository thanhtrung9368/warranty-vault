      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS is blocking Warrly notifications, so no warranty reminder can be delivered. Turn them back on in iOS Settings."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS đang chặn thông báo của Warrly, nên sẽ không có nhắc bảo hành nào được gửi. Bật lại trong Cài đặt iOS."

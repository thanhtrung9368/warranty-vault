        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa ẩn gói bảo hành nào. Gói nào bạn bấm “Đã xem, ẩn đi” sẽ nằm ở đây để khôi phục lại."
          }
        }
      }
    },
    "Chạm vào dòng chữ hoặc mã vạch được đánh dấu để chọn. Mã vạch có thể tự nhận; kết quả luôn là bản nháp để bạn kiểm tra lại." : {
      "extractionState" : "manual",

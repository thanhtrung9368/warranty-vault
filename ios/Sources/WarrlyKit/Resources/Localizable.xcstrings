    "PDF · luôn ở tiếng Việt cho công ty bảo hiểm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF · always in Vietnamese for the insurer"
          }
